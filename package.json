{
  "name": "reancode101-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test tests/studio*.test.mjs",
    "test:browser": "node tests/studio-browser.mjs",
    "dev:all": "node scripts/dev.mjs",
    "dev:api": ".venv/bin/python -m uvicorn backend.app.main:app --host 127.0.0.1 --port 8001",
    "test:api": ".venv/bin/python -m pytest backend/tests -q",
    "recordings:organize": ".venv/bin/python scripts/organize-recordings.py"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "@radix-ui/react-slot": "1.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0",
    "lucide-react": "0.563.0",
    "tailwindcss": "3.4.19",
    "autoprefixer": "10.4.23",
    "zustand": "5.0.14"
  },
  "optionalDependencies": {
    "@jitsi/rnnoise-wasm": "0.2.1"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "playwright-core": "1.60.0",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  },
  "overrides": {
    "postcss": "8.5.19",
    "rollup": "4.62.2",
    "esbuild": "0.25.12"
  }
}
