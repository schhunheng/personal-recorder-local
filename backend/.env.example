# Start from the repository root with scripts/dev.mjs (npm run dev:all).
EDU_HOST=127.0.0.1
EDU_PORT=8001
EDU_DATA_DIR=./backend/data
EDU_MAX_UPLOAD_MB=2048
EDU_MAX_DURATION_SECONDS=7200
EDU_RETENTION_DAYS=0
EDU_FFMPEG=ffmpeg
EDU_FFPROBE=ffprobe
# Optional: installed DeepFilterNet + pre-downloaded model directory. No auto downloads.
EDU_DF_MODEL_DIR=

# Optional offline CTranslate2 Whisper directory (must include model.bin).
STUDIO_WHISPER_MODEL=
